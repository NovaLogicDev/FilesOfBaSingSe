# Google OAuth 2.0 Client ID (Web Application)
# Configured in Google Cloud Console > APIs & Services > Credentials
# Authorized JavaScript Origins: http://localhost:5173, http://127.0.0.1:5173
VITE_GOOGLE_CLIENT_ID=

# Default GCS Configuration
VITE_DEFAULT_BUCKET=gs://partner-raw-master-archives-2026
VITE_DEFAULT_PROJECT_ID=demo-client-media-2026

# Feature Flags
VITE_ENABLE_LIVE_GCS=false
