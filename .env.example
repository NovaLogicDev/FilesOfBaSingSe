# Google OAuth 2.0 Client ID (Web Application)
# Configured in Google Cloud Console > APIs & Services > Credentials
#
# Development (http://localhost:5173):
# VITE_GOOGLE_CLIENT_ID=your-dev-client-id.apps.googleusercontent.com
#
# Production (https://the-files-of-basingse.web.app):
# VITE_GOOGLE_CLIENT_ID=your-prod-client-id.apps.googleusercontent.com

VITE_GOOGLE_CLIENT_ID=

# Default GCS Configuration
VITE_DEFAULT_BUCKET=gs://mediaserverrecovery
VITE_DEFAULT_PROJECT_ID=novalogic-dev

# Feature Flags
VITE_ENABLE_LIVE_GCS=true
